//- The front page (ROADMAP-themes §S11.7, Ansitz): the newest post with a
//- picture as the hero (the hero-media seam behind its title, description,
//- a link t('Read more'), location and image_note), the page body as the
//- statement, the next `blog.home_posts` posts as a wall of cards, the
//- highlight strip, the featured series and the about block. Without a post
//- with a picture, the page's own title is the <h1>.
extends ../layouts/layout.pug

block main
    if themeAnsitz.heroPost(pageLang({ meta }))
        - const item = themeAnsitz.heroPost(pageLang({ meta }))
        section.home-hero
            .home-hero__image
                include ../partials/hero-media.pug
            .home-hero__inner
                div
                    h1.home-hero__title
                        a(href=item.meta.href)= item.meta.title
                    if item.meta.description
                        p.home-hero__lead= item.meta.description
                    .home-hero__actions
                        a.button.button--primary(href=item.meta.href)= t('Read more')
                if item.meta.location || item.meta.image_note
                    .home-hero__aside
                        if item.meta.location
                            b= item.meta.location
                        if item.meta.image_note
                            span= item.meta.image_note
    else
        include ../partials/page-header.pug
    if String(content || '').trim()
        .home-statement
            != content
    if themeAnsitz.homePosts(pageLang({ meta })).length
        section.post-list
            h2.post-list__title= t('Recent posts')
            if meta.archive_href
                a.post-list__more(href=meta.archive_href)= t('All posts')
            ol.post-list__items
                each item, index in themeAnsitz.homePosts(pageLang({ meta }))
                    - const position = index
                    - const featured = index === 0
                    include ../partials/post-card.pug
    include ../partials/home-highlight.pug
    include ../partials/home-series.pug
    include ../partials/home-about.pug
